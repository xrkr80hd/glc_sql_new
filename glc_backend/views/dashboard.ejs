                                        <div style="background:#f8f9fa;border-radius:8px;padding:1rem;color:#555;white-space:pre-wrap;"> <%= youthScripture.devotional %> </div>
                                    <% } %>
                                <% } else { %>
                                    <div class="empty-state" style="padding:1.5rem;background:#f8f9fa;border-radius:8px;">
                                        <div class="empty-state-icon">🕊️</div>
                                        <p>No scripture loaded yet. Add one above.</p>
                                    </div>
                                <% } %>
                            </div>

                            <div class="youth-viewer-card">
                                <h3>📢 Upcoming Announcements</h3>
                                <% const topAnnouncements = (youthAnnouncements || []).slice(0, 3); %>
                                <% if (topAnnouncements.length > 0) { %>
                                    <ul style="list-style:none;padding:0;margin:0;display:grid;gap:0.75rem;">
                                        <% topAnnouncements.forEach(function(announcement) { %>
                                            <li style="background:#f8f9ff;border-radius:8px;padding:0.9rem;border-left:3px solid #667eea;">
                                                <strong style="display:block;color:#333;margin-bottom:0.35rem;"><%= announcement.title %></strong>
                                                <% if (announcement.event_date) { %>
                                                    <span style="display:block;color:#666;font-size:0.85rem;margin-bottom:0.35rem;">📅 <%= new Date(announcement.event_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                                                <% } %>
                                                <span style="color:#555;font-size:0.9rem;white-space:pre-wrap;"> <%= announcement.content %> </span>
                                            </li>
                                        <% }); %>
                                    </ul>
                                    <% if (youthAnnouncements.length > 3) { %>
                                        <small style="display:block;margin-top:0.75rem;color:#666;">Showing the latest 3 of <%= youthAnnouncements.length %> announcement(s).</small>
                                    <% } %>
                                <% } else { %>
                                    <div class="empty-state" style="padding:1.5rem;background:#f8f9fa;border-radius:8px;">
                                        <div class="empty-state-icon">📣</div>
                                        <p>No youth announcements yet.</p>
                                    </div>
                                <% } %>
                            </div>

                            <div class="youth-viewer-card">
                                <h3>🎞️ Gallery Spotlight</h3>
                                <% const featuredAlbum = (youthAlbums && youthAlbums.length > 0) ? youthAlbums[0] : null; %>
                                <% if (featuredAlbum) { %>
                                    <div>
                                        <strong style="color:#333;display:block;margin-bottom:0.5rem;">Album:</strong>
                                        <span style="font-size:1.05rem;color:#444;font-weight:600;display:block;margin-bottom:0.25rem;"><%= featuredAlbum.title %></span>
                                        <% if (featuredAlbum.event_date) { %>
                                            <span style="display:block;color:#666;font-size:0.85rem;margin-bottom:0.75rem;">📅 <%= new Date(featuredAlbum.event_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                                        <% } %>
                                        <% if (featuredAlbum.summary) { %>
                                            <p style="color:#555;font-size:0.9rem;margin-bottom:0.75rem;"><%= featuredAlbum.summary %></p>
                                        <% } %>
                                    </div>
                                    <% const previewMedia = (featuredAlbum.media || []).slice(0, 4); %>
                                    <% if (previewMedia.length > 0) { %>
                                        <div class="viewer-gallery-grid">
                                            <% previewMedia.forEach(function(media) { %>
                                                <div class="viewer-gallery-thumb">
                                                    <% if (media.media_type === 'video') { %>
                                                        <video src="/uploads/<%= media.media_filename %>" muted preload="metadata"></video>
                                                    <% } else { %>
                                                        <img src="/uploads/<%= media.media_filename %>" alt="<%= media.media_caption || 'Album media preview' %>">
                                                    <% } %>
                                                </div>
                                            <% }); %>
                                        </div>
                                        <% if (featuredAlbum.media.length > previewMedia.length) { %>
                                            <small style="display:block;margin-top:0.75rem;color:#666;">+ <%= featuredAlbum.media.length - previewMedia.length %> more item(s) in this album.</small>
                                        <% } %>
                                    <% } else { %>
                                        <p style="color:#666;">No media uploaded to this album yet.</p>
                                    <% } %>
                                <% } else { %>
                                    <div class="empty-state" style="padding:1.5rem;background:#f8f9fa;border-radius:8px;">
                                        <div class="empty-state-icon">🎬</div>
                                        <p>No youth albums yet. Create one to see the preview here.</p>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Utilities -->
            <div class="card accordion-card">
                <div class="accordion-header" onclick="toggleAccordion(event, this)">
                    <div class="accordion-title">
                        <span class="accordion-icon">🔧</span>
                        <span>Utilities & Tools</span>
                    </div>
                    <span class="accordion-toggle">▼</span>
                </div>
                <div class="accordion-body">
                
                <!-- Fetch Live Stream Status -->
                <div style="margin-bottom: 1.5rem; padding: 1rem; background: #f8f9fa; border-radius: 6px;">
                    <h3 style="font-size: 1.1rem; margin-bottom: 0.8rem;">📡 Live Stream API Status</h3>
                    <p style="font-size: 0.9rem; color: #666; margin-bottom: 0.8rem;">
                        Test the live stream API to see what your visitors will see on the live page.
                    </p>
                    <button onclick="fetchStreamStatus()" class="btn btn-primary">🔄 Fetch Live Stream (API Test)</button>
                    <div id="stream-api-result" class="stream-api-result"></div>
                </div>

                <!-- Clear Sermons Cache -->
                <div style="padding: 1rem; background: #fff3cd; border-radius: 6px;">
                    <h3 style="font-size: 1.1rem; margin-bottom: 0.8rem;">📚 Sermons Management</h3>
                    <p style="font-size: 0.9rem; color: #666; margin-bottom: 0.8rem;">
                        Clear the sermons cache to fetch fresh sermon data from YouTube API.
                    </p>
                    <form method="POST" action="/refresh-sermons" style="display: inline;">
                        <button type="submit" class="btn btn-warning">🗑️ Clear Cache & Refresh Sermons</button>
                    </form>
                </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Visitor Inbox Section -->
    <div class="section" id="visitors">
        <div class="card">
            <div class="card-header">
                <h2>📬 Visitor Inbox</h2>
                <p class="muted">Manage "Plan Your Visit" submissions</p>
            </div>
            <div class="card-body">
                <% if (visits && visits.length > 0) { %>
                    <div style="margin-bottom: 1rem; display: flex; gap: 1rem; flex-wrap: wrap;">
                        <button onclick="printVisitors()" class="btn" style="background: #17a2b8;">🖨️ Print Greeter List</button>
                        <span style="color: #666; padding: 0.5rem 0;">Total: <%= visits.length %> visitor(s)</span>
                    </div>
                    
                    <div id="visitor-list" style="display: grid; gap: 1rem;">
                        <% visits.forEach(function(visit) { 
                            const visitDate = visit.visit_date ? new Date(visit.visit_date).toLocaleDateString('en-US', { 
                                weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' 
                            }) : 'Date not specified';
                            const isUnread = visit.is_read === 0;
                        %>
                            <div class="visitor-card <%= isUnread ? 'is-unread' : '' %>">
                                <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 0.5rem;">
                                    <div>
                                        <h3 style="margin: 0; color: #333; display: flex; align-items: center; gap: 0.5rem;">
                                            <%= visit.name %>
                                            <% if (isUnread) { %>
                                                <span style="background: #ffc107; color: #856404; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.7rem; font-weight: bold;">NEW</span>
                                            <% } %>
                                        </h3>
                                        <div style="font-size: 0.9rem; color: #666; margin-top: 0.25rem;">
                                            📅 <%= visitDate %> • 👥 Party of <%= visit.party_size %>
                                        </div>
                                    </div>
                                    <div style="display: flex; gap: 0.5rem;">
                                        <% if (isUnread) { %>
                                            <form action="/mark-visit-read/<%= visit.id %>" method="POST" style="display: inline;">
                                                <button type="submit" class="btn-small" style="background: #28a745; color: white; border: none; padding: 0.4rem 0.8rem; border-radius: 4px; cursor: pointer; font-size: 0.85rem;">✓ Mark Read</button>
                                            </form>
                                        <% } %>
                                        <form action="/delete-visit/<%= visit.id %>" method="POST" style="display: inline;" onsubmit="return confirm('Archive this visitor submission?');">
                                            <button type="submit" class="btn-small" style="background: #dc3545; color: white; border: none; padding: 0.4rem 0.8rem; border-radius: 4px; cursor: pointer; font-size: 0.85rem;">🗑️ Archive</button>
                                        </form>
                                    </div>
                                </div>
                                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.5rem; margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid #eee;">
                                    <div>
                                        <strong style="color: #666; font-size: 0.85rem;">Email:</strong><br>
                                        <a href="mailto:<%= visit.email %>" style="color: #667eea; text-decoration: none;"><%= visit.email %></a>
                                    </div>
                                    <% if (visit.phone) { %>
                                        <div>
                                            <strong style="color: #666; font-size: 0.85rem;">Phone:</strong><br>
                                            <a href="tel:<%= visit.phone %>" style="color: #667eea; text-decoration: none;"><%= visit.phone %></a>
                                        </div>
                                    <% } %>
                                </div>
                                <% if (visit.notes) { %>
                                    <div style="margin-top: 0.75rem; padding: 0.75rem; background: #f8f9fa; border-radius: 6px;">
                                        <strong style="color: #666; font-size: 0.85rem;">Notes:</strong><br>
                                        <span style="color: #333; font-size: 0.9rem;"><%= visit.notes %></span>
                                    </div>
                                <% } %>
                                <div style="margin-top: 0.5rem; font-size: 0.8rem; color: #999;">
                                    Submitted: <%= new Date(visit.created_at).toLocaleString('en-US') %>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div style="text-align: center; padding: 3rem 1rem; color: #666;">
                        <div style="font-size: 3rem; margin-bottom: 1rem;">📭</div>
                        <p>No visitor submissions yet. Share your "Plan Your Visit" link!</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Prayer Requests Section -->
    <div class="section" id="prayer-requests">
        <div class="card">
            <div class="card-header">
                <h2>🙏 Prayer Requests</h2>
                <p class="muted">Review every request that comes through the prayer page.</p>
            </div>
            <div class="card-body">
                <% if (prayerRequests && prayerRequests.length > 0) { %>
                    <div style="display:flex; gap:1.5rem; flex-wrap:wrap; align-items:center;">
                        <span class="section-subtitle">Total: <strong><%= prayerRequests.length %></strong></span>
                        <span class="section-subtitle">Awaiting prayer: <strong><%= prayerRequests.filter(p => p.is_prayed === 0).length %></strong></span>
                    </div>

                    <div style="margin-top:1.5rem; display:grid; gap:1rem;">
                        <% prayerRequests.forEach(function(prayer) {
                            const isNew = prayer.is_prayed === 0;
                            const displayName = (prayer.name && prayer.name.trim().length > 0) ? prayer.name : 'Anonymous';
                        %>
                            <div class="prayer-card <%= isNew ? 'is-new' : '' %>">
                                <div style="display:flex; justify-content:space-between; gap:1rem;">
                                    <div>
                                        <h3>
                                            <%= displayName %>
                                            <% if (isNew) { %><span class="badge-new">New</span><% } %>
                                        </h3>
                                        <div class="prayer-meta">
                                            Submitted <%= new Date(prayer.created_at).toLocaleString('en-US', {
                                                month: 'short',
                                                day: 'numeric',
                                                year: 'numeric',
                                                hour: 'numeric',
                                                minute: '2-digit'
                                            }) %>
                                        </div>
                                        <% if (prayer.email) { %>
                                            <div style="margin-top:0.4rem; font-size:0.9rem;">
                                                <strong style="color:rgba(226,232,240,0.85);">Email:</strong>
                                                <a href="mailto:<%= prayer.email %>" style="color:#38bdf8; text-decoration:none;">
                                                    <%= prayer.email %>
                                                </a>
                                            </div>
                                        <% } %>
                                    </div>

                                    <div class="prayer-actions">
                                        <% if (isNew) { %>
                                            <form action="/mark-prayer-prayed/<%= prayer.id %>" method="POST" style="display:inline;">
                                                <button type="submit" class="btn-small" style="background:#047857; color:white;">🙏 Mark Prayed</button>
                                            </form>
                                        <% } %>
                                        <form action="/delete-prayer/<%= prayer.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Archive this prayer request?');">
                                            <button type="submit" class="btn-small" style="background:#dc2626; color:white;">🗂️ Archive</button>
                                        </form>
                                    </div>
                                </div>

                                <div style="margin-top:1rem; padding:1rem; background:rgba(15,23,42,0.35); border-radius:10px;">
                                    <strong style="color:rgba(226,232,240,0.8); font-size:0.85rem; letter-spacing:0.05em;">Prayer Request</strong>
                                    <p style="margin:0.6rem 0 0; color:#e2e8f0; font-size:1rem; white-space:pre-wrap;"><%= prayer.request %></p>
                                </div>

                                <div style="margin-top:0.85rem;">
                                    <span class="prayer-badge <%= prayer.share_permission ? 'shareable' : 'private' %>">
                                        <%= prayer.share_permission ? '✅ Congregation may be updated' : '🔒 Pastoral team only' %>
                                    </span>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div style="text-align:center; padding:3rem 1rem; color:rgba(148,163,184,0.85);">
                        <div style="font-size:3rem; margin-bottom:1rem;">🕊️</div>
                        <p>No online prayer requests yet. Once someone submits, they’ll appear here instantly.</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Print Stylesheet -->
    <style media="print">
        @page { margin: 1cm; }
        body * { visibility: hidden; }
        #print-content, #print-content * { visibility: visible; }
        #print-content { position: absolute; left: 0; top: 0; width: 100%; }
        .no-print { display: none !important; }
    </style>

    <!-- Hidden Print Container -->
    <div id="print-content" style="display: none;">
        <div style="font-family: Arial, sans-serif;">
            <h1 style="text-align: center; border-bottom: 3px solid #667eea; padding-bottom: 0.5rem;">Liberty Church - Visitor List</h1>
            <p style="text-align: center; color: #666; margin-bottom: 2rem;">Generated: <%= new Date().toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></p>
            
            <% if (visits && visits.length > 0) { %>
                <table style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background: #667eea; color: white;">
                            <th style="border: 1px solid #ddd; padding: 0.75rem; text-align: left;">Name</th>
                            <th style="border: 1px solid #ddd; padding: 0.75rem; text-align: left;">Visit Date</th>
                            <th style="border: 1px solid #ddd; padding: 0.75rem; text-align: center;">Party Size</th>
                            <th style="border: 1px solid #ddd; padding: 0.75rem; text-align: left;">Contact</th>
                            <th style="border: 1px solid #ddd; padding: 0.75rem; text-align: left;">Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% visits.forEach(function(visit) { 
                            const visitDate = visit.visit_date ? new Date(visit.visit_date).toLocaleDateString('en-US', { 
                                month: 'short', day: 'numeric', year: 'numeric'
                            }) : 'TBD';
                        %>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 0.75rem;"><strong><%= visit.name %></strong></td>
                                <td style="border: 1px solid #ddd; padding: 0.75rem;"><%= visitDate %></td>
                                <td style="border: 1px solid #ddd; padding: 0.75rem; text-align: center;"><%= visit.party_size %></td>
                                <td style="border: 1px solid #ddd; padding: 0.75rem; font-size: 0.85rem;">
                                    <%= visit.email %><br>
                                    <% if (visit.phone) { %><%= visit.phone %><% } %>
                                </td>
                                <td style="border: 1px solid #ddd; padding: 0.75rem; font-size: 0.85rem;"><%= visit.notes || '-' %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
                <p style="margin-top: 2rem; padding-top: 1rem; border-top: 1px solid #ddd; color: #666; font-size: 0.9rem;">
                    Total Visitors: <%= visits.length %> | Please welcome our guests warmly!
                </p>
            <% } else { %>
                <p style="text-align: center; color: #666;">No visitors scheduled at this time.</p>
            <% } %>
        </div>
    </div>

    <script>
        // Print function for greeter handout
        function printVisitors() {
            const printContent = document.getElementById('print-content');
            printContent.style.display = 'block';
            window.print();
            printContent.style.display = 'none';
        }
        
        // Auto-refresh dashboard every 2 minutes to stay updated
        setTimeout(() => {
            console.log('Auto-refreshing dashboard...');
            window.location.reload();
        }, 120000);
        
        // Fetch Live Stream Status via API
        async function fetchStreamStatus(targetId = 'stream-api-result') {
            const resultDiv = document.getElementById(targetId);
            if (!resultDiv) {
                console.warn('Stream status target not found:', targetId);
                return;
            }

            resultDiv.style.display = 'block';
            resultDiv.innerHTML = '<span style="color: var(--dash-text-muted);">⏳ Fetching stream status from API...</span>';
            
            try {
                const response = await fetch('/api/current-stream');
                const data = await response.json();
                
                let html = '<strong style="color: #2dd4bf;">✅ API Response Received:</strong>';
                html += '<pre>' + JSON.stringify(data, null, 2) + '</pre>';
                
                if (data.stream && data.stream.embed_code) {
                    html += '<div style="margin-top: 0.75rem; padding: 0.85rem; background: rgba(16, 185, 129, 0.18); border-left: 4px solid var(--dash-success); border-radius: 6px;">';
                    html += '<strong>🔴 LS1 MODE (Live Stream Active)</strong><br>';
                    html += '<span style="font-size: 0.9rem; color: var(--dash-text);">Title: ' + (data.stream.stream_title || 'Untitled Stream') + '</span>';
                    html += '</div>';
                } else {
                    html += '<div style="margin-top: 0.75rem; padding: 0.85rem; background: rgba(59, 130, 246, 0.18); border-left: 4px solid #3b82f6; border-radius: 6px;">';
                    html += '<strong>🎬 LS2 MODE (Fallback Active)</strong><br>';
                    html += '<span style="font-size: 0.9rem; color: var(--dash-text);">No active live stream — fallback loop is showing.</span>';
                    html += '</div>';
                }
                
                resultDiv.innerHTML = html;
            } catch (error) {
                resultDiv.innerHTML = '<span style="color: var(--dash-error);">❌ API Error: ' + error.message + '</span><br>' +
                    '<span style="font-size: 0.85rem; color: var(--dash-text-muted);">Make sure the server is running and reachable.</span>';
            }
        }

        function clearEmbedField() {
            const field = document.getElementById('embed_code');
            if (field) {
                field.value = '';
                field.focus();
            }
            const statusPanel = document.getElementById('stream-status-result');
            if (statusPanel) {
                statusPanel.style.display = 'none';
                statusPanel.innerHTML = '';
            }
        }
        
        // Accordion toggle functionality
        function toggleAccordion(event, headerEl) {
            // Prevent default anchor behavior and stop event propagation
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }
            
            const card = headerEl.closest('.accordion-card');
            const body = card.querySelector('.accordion-body');
            const isExpanded = card.classList.contains('is-expanded');
            
            if (isExpanded) {
                // Collapse
                card.classList.remove('is-expanded');
                body.style.maxHeight = '0px';
            } else {
                // Expand
                card.classList.add('is-expanded');
                // Calculate full height including padding
                const scrollHeight = body.scrollHeight;
                body.style.maxHeight = scrollHeight + 'px';
                
                // After transition completes, set to auto for dynamic content
                setTimeout(() => {
                    if (card.classList.contains('is-expanded')) {
                        body.style.maxHeight = 'none';
                    }
                }, 350); // Match CSS transition duration
            }
            
            // Return false to ensure no page jump
            return false;
        }
        
        // Initialize expanded sections on page load
        document.addEventListener('DOMContentLoaded', function() {
            const expandedCards = document.querySelectorAll('.accordion-card.is-expanded');
            expandedCards.forEach(card => {
                const body = card.querySelector('.accordion-body');
                if (body) {
                    // Set initial max-height for expanded sections
                    body.style.maxHeight = 'none';
                }
            });
        });
        
        // Form validation
        // Image preview functionality
        document.addEventListener('DOMContentLoaded', function() {
            const mediaInput = document.getElementById('media');
            const previewDiv = document.getElementById('image-preview');
            const previewImg = document.getElementById('preview-img');
            
            if (mediaInput) {
                mediaInput.addEventListener('change', function(e) {
                    const file = e.target.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = function(event) {
                            previewImg.src = event.target.result;
                            previewDiv.style.display = 'block';
                        };
                        reader.readAsDataURL(file);
                    }
                });
            }
        });
        
        function clearImagePreview() {
            document.getElementById('media').value = '';
            document.getElementById('image-preview').style.display = 'none';
            document.getElementById('preview-img').src = '';
        }
    </script>
</body>
</html>