                        <span class="accordion-icon">🎞️</span>
                        <span>Youth Gallery</span>
                    </div>
                    <span class="accordion-toggle">▼</span>
                </div>
                <div class="accordion-body">
                <p class="section-subtitle" style="margin-bottom:1.5rem;">Organize photo and video albums for past youth events. Upload files directly from this dashboard and publish them on the youth page.</p>

                <form method="POST" action="/create-youth-album" enctype="multipart/form-data" class="youth-album-form">
                    <div class="form-group">
                        <label for="album_title">Album Title</label>
                        <input type="text" id="album_title" name="title" required placeholder="e.g. Summer Retreat 2025">
                    </div>
                    <div class="form-group">
                        <label for="album_summary">Short Description</label>
                        <textarea id="album_summary" name="summary" placeholder="Highlight what made this event special" style="min-height:100px;"></textarea>
                    </div>
                    <div class="form-group">
                        <label for="album_event_date">Event Date (optional)</label>
                        <input type="date" id="album_event_date" name="event_date">
                    </div>
                    <div class="form-group">
                        <label for="album_cover">Cover Photo (optional)</label>
                        <input type="file" id="album_cover" name="cover_media" accept="image/*">
                        <small style="color:#666;display:block;margin-top:0.35rem;">Upload a landscape image (JPG/PNG/WebP) to use as the album cover.</small>
                    </div>
                    <div class="album-actions">
                        <button type="submit" class="btn btn-primary">📁 Create Youth Album</button>
                    </div>
                </form>

                <% if (youthAlbums && youthAlbums.length > 0) { %>
                    <div class="youth-album-list">
                        <% youthAlbums.forEach(function(album) { %>
                            <div class="youth-album-card">
                                <div class="youth-album-head">
                                    <div class="youth-album-cover">
                                        <% const coverSrc = album.cover_media ? '/uploads/' + album.cover_media : (album.media && album.media.length && album.media[0].media_filename ? '/uploads/' + album.media[0].media_filename : '/assets/youth-backdrop.png'); %>
                                        <img src="<%= coverSrc %>" alt="<%= album.title %> cover" loading="lazy">
                                    </div>
                                    <div class="youth-album-info">
                                        <h3><%= album.title %></h3>
                                        <% if (album.event_date) { %>
                                            <p class="album-meta">📅 <%= new Date(album.event_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></p>
                                        <% } %>
                                        <% if (album.summary) { %>
                                            <p class="album-summary"><%= album.summary %></p>
                                        <% } %>
                                        <small class="album-subtle"><%= album.media.length %> media item(s) • Created <%= new Date(album.created_at).toLocaleDateString() %></small>
                                    </div>
                                    <form method="POST" action="/delete-youth-album/<%= album.id %>" class="youth-album-delete" onsubmit="return confirm('Delete this album and all of its media?');">
                                        <button type="submit" class="btn" style="background:#dc3545;color:white;">🗑️ Delete Album</button>
                                    </form>
                                </div>

                                <form method="POST" action="/add-youth-media" enctype="multipart/form-data" class="youth-media-upload">
                                    <input type="hidden" name="album_id" value="<%= album.id %>">
                                    <div class="form-group">
                                        <label>Add Photo or Video</label>
                                        <input type="file" name="media" accept="image/*,video/mp4,video/webm,video/quicktime" required>
                                        <small style="color:#666;display:block;margin-top:0.35rem;">Supports JPG, PNG, WebP, MP4, MOV, and WebM files up to 75MB.</small>
                                    </div>
                                    <div class="form-group">
                                        <label for="caption_<%= album.id %>">Caption (optional)</label>
                                        <input type="text" id="caption_<%= album.id %>" name="caption" placeholder="Describe this moment">
                                    </div>
                                    <div class="album-actions">
                                        <button type="submit" class="btn btn-success">⬆️ Upload to Album</button>
                                    </div>
                                </form>

                                <% if (album.media && album.media.length > 0) { %>
                                    <div class="youth-media-grid">
                                        <% album.media.forEach(function(media) { %>
                                            <div class="youth-media-card">
                                                <div class="youth-media-thumb <%= media.media_type === 'video' ? 'is-video' : '' %>">
                                                    <% if (media.media_type === 'video') { %>
                                                        <video src="/uploads/<%= media.media_filename %>" muted preload="metadata"></video>
                                                    <% } else { %>
                                                        <img src="/uploads/<%= media.media_filename %>" alt="<%= media.media_caption || ('Album media ' + media.id) %>" loading="lazy">
                                                    <% } %>
                                                </div>
                                                <% if (media.media_caption) { %>
                                                    <p class="media-caption"><%= media.media_caption %></p>
                                                <% } %>
                                                <form method="POST" action="/delete-youth-media/<%= media.id %>" onsubmit="return confirm('Remove this media item?');">
                                                    <button type="submit" class="btn btn-small" style="background:#f44336;color:white;">Remove</button>
                                                </form>
                                            </div>
                                        <% }); %>
                                    </div>
                                <% } else { %>
                                    <p class="media-empty">No media yet. Upload the first photo or video above.</p>
                                <% } %>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="empty-state" style="background:#f8f9fb;border-radius:10px;border:2px dashed rgba(102,126,234,0.35);">
                        <div class="empty-state-icon">🎬</div>
                        <p>No youth albums yet. Create one using the form above.</p>
                    </div>
                <% } %>

                <form method="POST" action="/update-youth-page" style="margin-top:1.5rem;">
                    <button type="submit" class="btn btn-success" style="width:100%;padding:1rem;font-size:1.1rem;">🚀 Update Youth Page</button>
                </form>
                <div style="margin-top:1rem;padding:1rem;background:rgba(16, 185, 129, 0.1);border-left:4px solid var(--dash-success);border-radius:6px;font-size:0.85rem;color:var(--dash-text-muted);">
                    <strong>✅ Publishing:</strong> Click <em>Update Youth Page</em> above after making album changes to refresh the gallery on the public site.
                </div>
            </div>
            </div>

            <!-- Youth Page Content Viewer -->
