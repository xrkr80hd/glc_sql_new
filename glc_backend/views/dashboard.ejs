                            <div class="content-item" style="background:#f1f3f9;border-left-color:#667eea;">
                                <div style="display:flex;justify-content:space-between;gap:1rem;align-items:flex-start;">
                                    <div>
                                        <h4 style="color:#222;"><%= announcement.title %></h4>
                                        <% if (announcement.event_date) { %>
                                            <div class="date" style="color:#444;">📅 <%= new Date(announcement.event_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></div>
                                        <% } %>
                                        <p style="color:#333;white-space:pre-wrap;"><%= announcement.content %></p>
                                        <small style="color:#666;">Added <%= new Date(announcement.created_at).toLocaleDateString() %></small>
                                    </div>
                                    <form method="POST" action="/delete-youth-announcement/<%= announcement.id %>" onsubmit="return confirm('Delete this youth announcement?');">
                                        <button type="submit" class="btn" style="background:#dc3545;color:white;padding:0.5rem 1rem;font-size:0.85rem;">🗑️ Delete</button>
                                    </form>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                    <div style="text-align:center;margin-top:0.75rem;">
                        <small style="color:#666;"><%= youthAnnouncements.length %> youth announcement(s)</small>
                    </div>
                <% } else { %>
                    <div class="empty-state" style="background:#f8f9fb;border-radius:10px;border:2px dashed rgba(102,126,234,0.35);">
                        <div class="empty-state-icon">📣</div>
