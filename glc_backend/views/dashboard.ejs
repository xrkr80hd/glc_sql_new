                            <div class="form-group">
                                <label for="title">Title:</label>
                                <input type="text" id="title" name="title" required placeholder="Announcement or event title">
                            </div>
                            <div class="form-group">
                                <label for="content">Content:</label>
                                <textarea id="content" name="content" required placeholder="Enter your announcement or event details here..."></textarea>
                            </div>
                            <div class="form-group">
                                <label for="event_date">Event Date (optional):</label>
                                <input type="date" id="event_date" name="event_date">
                                <small style="color: #666;">Leave blank for general announcements</small>
                            </div>
                            <div class="form-group">
                                <label for="media">📷 Add Image/Flyer (optional):</label>
                                <input type="file" id="media" name="media" accept="image/*" style="padding: 0.5rem;">
                                <small style="color: #666; display: block; margin-top: 0.5rem;">Upload a flyer, photo, or graphic (JPG, PNG, GIF - max 5MB)</small>
                                <div style="margin-top: 0.75rem; padding: 0.75rem; background: #f8f9fa; border-left: 3px solid #667eea; border-radius: 4px; font-size: 0.85rem;">
                                    <strong style="color: #667eea;">📐 Recommended Sizes:</strong>
                                    <ul style="margin: 0.5rem 0 0 1.2rem; line-height: 1.8; color: #555;">
                                        <li><strong style="color: #28a745;">✨ Best:</strong> 1080 x 1080px (Square - Instagram format)</li>
                                        <li><strong style="color: #17a2b8;">👍 Better:</strong> 1200 x 628px (Landscape - Facebook format)</li>
                                        <li><strong style="color: #ffc107;">👌 Good:</strong> 1080 x 1350px (Portrait - Instagram story)</li>
                                    </ul>
                                    <small style="color: #666; display: block; margin-top: 0.5rem;">💡 Tip: Square format (1080x1080) works best across all devices and looks great on the homepage!</small>
                                </div>
                                <div id="image-preview" style="margin-top: 1rem; display: none;">
                                    <img id="preview-img" style="max-width: 300px; border-radius: 8px; border: 2px solid #e1e5e9;" />
                                    <button type="button" onclick="clearImagePreview()" style="display: block; margin-top: 0.5rem; padding: 0.5rem 1rem; background: #dc3545; color: white; border: none; border-radius: 4px; cursor: pointer;">✕ Remove</button>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-success" style="font-size: 1.1rem; padding: 1rem 2rem;">➕ Add & Update Homepage</button>
                        </form>
                        <div style="margin-top: 1rem; padding: 1rem; background: #e3f2fd; border-radius: 6px; font-size: 0.9rem; color: #1565c0;">
                            <strong>IndexUpdate 1:</strong> Content will be added and homepage will be updated automatically when you click the button above
                        </div>
                    </div>

                    <div class="accordion-section">
                        <h2>📋 Current Homepage Content</h2>
                        <% if (content && content.length > 0) { %>
                            <div class="content-list">
                                <% content.forEach(function(item) { %>
                                    <div class="content-item">
                                        <div style="display: flex; gap: 1.5rem; align-items: start;">
                                            <% if (item.media_filename) { %>
                                                <div style="flex-shrink: 0;">
                                                    <img src="/uploads/<%= item.media_filename %>" alt="<%= item.media_alt_text || item.title %>" style="width: 120px; height: 120px; object-fit: cover; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                                                </div>
                                            <% } %>
                                            <div style="flex: 1;">
                                                <h4><%= item.title %></h4>
                                                <% if (item.event_date) { %>
                                                    <div class="date">
                                                        📅 <%= new Date(item.event_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                                                    </div>
                                                <% } %>
                                                <p><%= item.content.length > 150 ? item.content.substring(0, 150) + '...' : item.content %></p>
                                                <small style="color: #888;">Added: <%= new Date(item.created_at).toLocaleDateString() %></small>
                                                <% if (item.media_filename) { %>
                                                    <div style="margin-top: 0.5rem;">
                                                        <span style="background: #e3f2fd; color: #1976d2; padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.8rem;">📷 Has Image</span>
                                                    </div>
                                                <% } %>
                                            </div>
                                            <div style="display: flex; gap: 0.5rem; flex-shrink: 0;">
                                                <form method="POST" action="/delete-content/<%= item.id %>" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this content?');">
                                                    <button type="submit" class="btn" style="background: #dc3545; color: white; padding: 0.5rem 1rem; font-size: 0.85rem;">🗑️ Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                            <div style="text-align: center; margin-top: 1rem;">
                                <small style="color: #666;"><%= content.length %> content item(s) ready for homepage</small>
                            </div>
                        <% } else { %>
                            <div class="empty-state">
                                <div class="empty-state-icon">📭</div>
                                <p>No content on homepage yet.</p>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Youth Scripture & Devotional -->
                <div class="card accordion-card" id="youth-scripture-admin">
                    <div class="accordion-header" onclick="toggleAccordion(event, this)">
                        <div class="accordion-title">
                            <span class="accordion-icon">📖</span>
                            <span>Youth Scripture & Devotional</span>
                        </div>
                        <span class="accordion-toggle">▼</span>
                    </div>
                    <div class="accordion-body">
                        <div class="accordion-section">
