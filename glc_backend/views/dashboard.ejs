                                </div>
                                <div class="form-group">
                                    <label for="scripture_reference">Scripture Reference</label>
                                    <input type="text" id="scripture_reference" name="scripture_reference" required placeholder="e.g. Psalm 119:105" value="<%= youthScripture ? youthScripture.scripture_reference : '' %>">
                                </div>
                                <div class="form-group">
                                    <label for="devotional">Weekly Devotional</label>
                                    <textarea id="devotional" name="devotional" required placeholder="Share a 2-3 paragraph devo for students" style="min-height:160px;"><%= youthScripture ? youthScripture.devotional : '' %></textarea>
                                </div>
                                <button type="submit" class="btn btn-primary">💾 Save Scripture & Devotional</button>
                            </form>
                            <form method="POST" action="/update-youth-page" style="margin-top:1rem;">
                                <button type="submit" class="btn btn-success" style="width:100%;padding:1rem;font-size:1.1rem;">🚀 Update Youth Page</button>
                            </form>
                            <div style="margin-top:1rem;padding:1rem;background:rgba(16, 185, 129, 0.1);border-left:4px solid var(--dash-success);border-radius:6px;font-size:0.85rem;color:var(--dash-text-muted);">
                                <strong>✅ Publishing:</strong> Click <em>Update Youth Page</em> above to push scripture and devotional changes live.
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Youth Announcements -->
                <div class="card accordion-card" id="youth-announcements-admin">
                    <div class="accordion-header" onclick="toggleAccordion(event, this)">
                        <div class="accordion-title">
                            <span class="accordion-icon">📢</span>
                            <span>Youth Announcements</span>
                        </div>
                        <span class="accordion-toggle">▼</span>
                    </div>
                    <div class="accordion-body">
                    <p class="section-subtitle" style="margin-bottom:1.5rem;">Add updates just for the youth page. These do <strong>not</strong> show on the main homepage.</p>
                    <form method="POST" action="/add-youth-announcement" style="margin-bottom:1.5rem;">
                    <div class="form-group">
                        <label for="youth_title">Title</label>
                        <input type="text" id="youth_title" name="title" required placeholder="Announcement title">
                    </div>
                    <div class="form-group">
                        <label for="youth_content">Details</label>
                        <textarea id="youth_content" name="content" required placeholder="Explain what students/parents need to know" style="min-height:120px;"></textarea>
                    </div>
                    <div class="form-group">
                        <label for="youth_event_date">Event Date (optional)</label>
                        <input type="date" id="youth_event_date" name="event_date">
                    </div>
                    <button type="submit" class="btn btn-success">➕ Add Youth Announcement</button>
                </form>

                <% if (youthAnnouncements && youthAnnouncements.length > 0) { %>
                    <div class="content-list" style="max-height:320px;overflow:auto;">
