                        <span class="accordion-icon">🧭</span>
                        <span>Youth Page Content Viewer</span>
                    </div>
                    <span class="accordion-toggle">▼</span>
                </div>
                <div class="accordion-body">
                    <div class="accordion-section">
                        <p class="section-subtitle" style="margin-bottom:1.5rem;">Preview exactly what will render on the youth page before publishing updates.</p>
                        <div class="youth-viewer-grid">
                            <div class="youth-viewer-card">
                                <h3>📖 Scripture & Devotional</h3>
                                <% if (youthScripture) { %>
                                    <blockquote style="font-size:1rem;line-height:1.7;color:#333;border-left:4px solid #667eea;padding-left:1rem;margin-bottom:1rem;">
                                        “<%= youthScripture.scripture_text %>”
                                        <footer style="margin-top:0.75rem;font-size:0.9rem;color:#666;">— <%= youthScripture.scripture_reference %></footer>
                                    </blockquote>
