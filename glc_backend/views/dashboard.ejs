                </form>
                <div style="margin-top:1rem;padding:1rem;background:rgba(16, 185, 129, 0.1);border-left:4px solid var(--dash-success);border-radius:6px;font-size:0.85rem;color:var(--dash-text-muted);">
                    <strong>✅ Publishing:</strong> Click <em>Update Youth Page</em> above after editing announcements to push them live.
                </div>
            </div>
            </div>

            <!-- Youth Gallery Management -->
            <div class="card accordion-card" id="youth-gallery-admin">
